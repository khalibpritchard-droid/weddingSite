<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Great+Vibes&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />

<style>
/* ─── TOKENS ──────────────────────────────────────────────── */
:root {
--sage: #8a9e85;
--sage-lt: #c5d4c1;
--cream: #faf6ef;
--beige: #ede5d8;
--linen: #f5ede0;
--brown: #3a2c22;
--brown-md:#5c4033;
--gold: #b59a6a;
--white: #ffffff;
--ff-script: 'Great Vibes', cursive;
--ff-serif: 'Cormorant Garamond', Georgia, serif;
--ff-sans: 'Jost', sans-serif;
--ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

/* ─── RESET ───────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
background: var(--cream);
color: var(--brown);
font-family: var(--ff-serif);
line-height: 1.75;
overflow-x: hidden;
}
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }

/* ─── PASSWORD GATE ───────────────────────────────────────── */
#gate {
position: fixed; inset: 0; z-index: 9999;
background: var(--cream);
display: flex; align-items: center; justify-content: center;
flex-direction: column;
transition: opacity 0.9s var(--ease-out), visibility 0.9s;
}
#gate.unlocked { opacity: 0; visibility: hidden; pointer-events: none; }

.gate-inner {
text-align: center;
padding: 3rem 2rem;
max-width: 420px;
width: 100%;
}
.gate-floral {
width: 120px;
margin: 0 auto 1.5rem;
opacity: 0.55;
}
.gate-title {
font-family: var(--ff-script);
font-size: clamp(2.8rem, 8vw, 4rem);
color: var(--brown);
line-height: 1.1;
margin-bottom: 0.4rem;
}
.gate-sub {
font-family: var(--ff-sans);
font-size: 0.72rem;
letter-spacing: 0.22em;
text-transform: uppercase;
color: var(--sage);
margin-bottom: 2.4rem;
}
.gate-label {
font-family: var(--ff-sans);
font-size: 0.7rem;
letter-spacing: 0.18em;
text-transform: uppercase;
color: var(--brown-md);
display: block;
margin-bottom: 0.55rem;
}
.gate-input {
width: 100%;
padding: 0.85rem 1.25rem;
border: 1px solid var(--sage-lt);
border-radius: 2px;
background: var(--white);
font-family: var(--ff-serif);
font-size: 1rem;
color: var(--brown);
outline: none;
transition: border-color 0.25s;
text-align: center;
letter-spacing: 0.1em;
}
.gate-input:focus { border-color: var(--sage); }
.gate-input::placeholder { color: #bbb; font-style: italic; }
.gate-btn {
margin-top: 1rem;
width: 100%;
padding: 0.9rem;
background: var(--brown);
color: var(--cream);
font-family: var(--ff-sans);
font-size: 0.72rem;
letter-spacing: 0.22em;
text-transform: uppercase;
border: none;
border-radius: 2px;
cursor: pointer;
transition: background 0.25s, transform 0.15s;
}
.gate-btn:hover { background: var(--brown-md); transform: translateY(-1px); }
.gate-error {
font-family: var(--ff-sans);
font-size: 0.72rem;
color: #b36a5e;
letter-spacing: 0.08em;
margin-top: 0.75rem;
min-height: 1em;
opacity: 0;
transition: opacity 0.3s;
}
.gate-error.show { opacity: 1; }

/* ─── MAIN SITE (hidden until unlocked) ──────────────────── */
#site {
opacity: 0;
transition: opacity 1s var(--ease-out) 0.3s;
}
#site.visible { opacity: 1; }

/* ─── SCROLL REVEAL ───────────────────────────────────────── */
.reveal {
opacity: 0;
transform: translateY(28px);
transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
}
.reveal.in { opacity: 1; transform: none; }
.reveal-delay-1 { transition-delay: 0.15s; }
.reveal-delay-2 { transition-delay: 0.3s; }
.reveal-delay-3 { transition-delay: 0.45s; }
.reveal-delay-4 { transition-delay: 0.6s; }

/* ─── NAV ─────────────────────────────────────────────────── */
nav {
position: fixed; top: 0; left: 0; right: 0; z-index: 100;
display: flex; align-items: center; justify-content: center;
gap: 2.5rem;
padding: 1.2rem 2rem;
background: rgba(250,246,239,0.88);
backdrop-filter: blur(8px);
border-bottom: 1px solid rgba(138,158,133,0.2);
}
nav a {
font-family: var(--ff-sans);
font-size: 0.68rem;
letter-spacing: 0.22em;
text-transform: uppercase;
color: var(--brown-md);
transition: color 0.2s;
}
nav a:hover { color: var(--sage); }

/* ─── HERO ────────────────────────────────────────────────── */
#hero {
min-height: 100svh;
display: grid;
place-items: center;
text-align: center;
padding: 8rem 2rem 5rem;
position: relative;
overflow: hidden;
background: var(--cream);
}
#hero::before {
content: '';
position: absolute; inset: 0;
background: radial-gradient(ellipse 70% 60% at 50% 40%, #e8ede4 0%, transparent 70%);
pointer-events: none;
}
.hero-floral-tl, .hero-floral-br {
position: absolute;
width: clamp(200px, 32vw, 380px);
opacity: 0.28;
pointer-events: none;
}
.hero-floral-tl { top: -2%; left: -3%; }
.hero-floral-br { bottom: -2%; right: -3%; transform: rotate(180deg); }

.hero-inner { position: relative; z-index: 1; }
.hero-date-loc {
font-family: var(--ff-sans);
font-size: 0.68rem;
letter-spacing: 0.28em;
text-transform: uppercase;
color: var(--sage);
margin-bottom: 1.8rem;
}
.hero-names {
font-family: var(--ff-script);
font-size: clamp(4rem, 12vw, 8rem);
color: var(--brown);
line-height: 1.05;
margin-bottom: 0.6rem;
}
.hero-ampersand {
display: block;
font-size: 0.65em;
color: var(--sage);
}
.hero-divider {
display: flex; align-items: center; gap: 1rem;
justify-content: center;
margin: 1.8rem auto;
max-width: 320px;
}
.hero-divider span {
flex: 1; height: 1px;
background: linear-gradient(to right, transparent, var(--sage-lt), transparent);
}
.hero-divider-icon { color: var(--gold); font-size: 0.85rem; }
.hero-detail {
font-family: var(--ff-serif);
font-size: 1.05rem;
font-style: italic;
color: var(--brown-md);
letter-spacing: 0.04em;
}
.hero-scroll-hint {
position: absolute; bottom: 2.2rem; left: 50%; transform: translateX(-50%);
display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
font-family: var(--ff-sans); font-size: 0.6rem;
letter-spacing: 0.22em; text-transform: uppercase;
color: var(--sage); opacity: 0.75;
animation: nudge 2.4s ease-in-out infinite;
}
@keyframes nudge { 0%,100%{transform:translateX(-50%) translateY(0)} 55%{transform:translateX(-50%) translateY(6px)} }

/* ─── COUNTDOWN ───────────────────────────────────────────── */
#countdown {
background: var(--brown);
padding: 5rem 2rem;
text-align: center;
position: relative;
overflow: hidden;
}
#countdown::before {
content: '';
position: absolute; inset: 0;
background: url("data:image/svg+xml,%3Csvg width='400' height='400' viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='200' cy='200' r='180' fill='none' stroke='%23ffffff08' stroke-width='1'/%3E%3Ccircle cx='200' cy='200' r='140' fill='none' stroke='%23ffffff05' stroke-width='1'/%3E%3C/svg%3E") center/cover;
pointer-events: none;
}
.countdown-heading {
font-family: var(--ff-script);
font-size: clamp(2rem, 6vw, 3rem);
color: var(--cream);
margin-bottom: 3rem;
opacity: 0.9;
}
.countdown-grid {
display: flex; gap: clamp(1.5rem, 4vw, 4rem);
justify-content: center; flex-wrap: wrap;
}
.countdown-unit {
display: flex; flex-direction: column; align-items: center;
}
.countdown-num {
font-family: var(--ff-serif);
font-size: clamp(3rem, 8vw, 5.5rem);
font-weight: 300;
color: var(--white);
line-height: 1;
min-width: 2ch;
text-align: center;
}
.countdown-sep {
font-size: clamp(2.5rem, 6vw, 4.5rem);
color: var(--gold);
opacity: 0.6;
line-height: 1;
align-self: flex-start;
padding-top: 0.1em;
font-family: var(--ff-serif);
font-weight: 300;
}
.countdown-label {
font-family: var(--ff-sans);
font-size: 0.6rem;
letter-spacing: 0.22em;
text-transform: uppercase;
color: var(--sage-lt);
margin-top: 0.5rem;
}

/* ─── SECTION UTILITY ─────────────────────────────────────── */
section { padding: 6rem 2rem; }
.section-tag {
font-family: var(--ff-sans);
font-size: 0.65rem;
letter-spacing: 0.28em;
text-transform: uppercase;
color: var(--sage);
margin-bottom: 0.8rem;
display: block;
}
.section-title {
font-family: var(--ff-script);
font-size: clamp(2.4rem, 6vw, 3.6rem);
color: var(--brown);
line-height: 1.1;
margin-bottom: 1.5rem;
}
.section-divider {
width: 60px; height: 1px;
background: var(--gold);
margin: 0 auto 2rem;
}

/* ─── RSVP ────────────────────────────────────────────────── */
#rsvp { background: var(--linen); text-align: center; }
.rsvp-card {
max-width: 520px;
margin: 0 auto;
background: var(--white);
border-radius: 4px;
padding: 3.5rem 3rem;
box-shadow: 0 4px 40px rgba(58,44,34,0.1), 0 1px 4px rgba(58,44,34,0.06);
position: relative;
overflow: hidden;
}
.rsvp-card::before {
content: '';
position: absolute; top: 0; left: 0; right: 0;
height: 6px;
background: linear-gradient(90deg, var(--sage-lt), var(--gold), var(--sage-lt));
}
.wax-seal {
width: 68px; height: 68px;
border-radius: 50%;
background: radial-gradient(circle at 38% 35%, #c4a97a, var(--gold) 50%, #8a6f3e);
margin: 0 auto 2rem;
display: flex; align-items: center; justify-content: center;
box-shadow: 0 2px 12px rgba(181,154,106,0.45);
position: relative;
}
.wax-seal::after {
content: '✦';
color: rgba(255,255,255,0.7);
font-size: 1.4rem;
}
.rsvp-body {
font-family: var(--ff-serif);
font-size: 1.05rem;
color: var(--brown-md);
font-style: italic;
line-height: 1.8;
margin-bottom: 2rem;
}
.rsvp-deadline {
font-family: var(--ff-sans);
font-size: 0.68rem;
letter-spacing: 0.18em;
text-transform: uppercase;
color: var(--sage);
margin-bottom: 2rem;
}
.rsvp-btn {
display: inline-block;
padding: 1rem 2.8rem;
background: var(--brown);
color: var(--cream);
font-family: var(--ff-sans);
font-size: 0.7rem;
letter-spacing: 0.22em;
text-transform: uppercase;
border: none;
border-radius: 2px;
cursor: pointer;
position: relative;
overflow: hidden;
transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
box-shadow: 0 2px 12px rgba(58,44,34,0.25);
}
.rsvp-btn::after {
content: '';
position: absolute; inset: 0;
background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.12) 50%, transparent 70%);
transform: translateX(-100%);
transition: transform 0.5s var(--ease-out);
}
.rsvp-btn:hover { background: var(--brown-md); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(58,44,34,0.3); }
.rsvp-btn:hover::after { transform: translateX(100%); }

/* ─── LOVE STORY ──────────────────────────────────────────── */
#story { text-align: center; }
.story-inner {
max-width: 640px;
margin: 0 auto;
}
.story-text {
font-family: var(--ff-serif);
font-size: 1.15rem;
color: var(--brown-md);
line-height: 2;
margin-bottom: 1.5rem;
}
.story-text:first-of-type::first-letter {
font-family: var(--ff-script);
font-size: 3.5em;
float: left;
line-height: 0.75;
margin: 0.05em 0.08em 0 0;
color: var(--sage);
}
.story-image-frame {
margin: 3rem auto;
max-width: 520px;
border-radius: 3px;
overflow: hidden;
box-shadow: 0 4px 32px rgba(58,44,34,0.12);
position: relative;
}
.story-image-frame img { width: 100%; height: 360px; object-fit: cover; }
.story-image-frame::after {
content: '';
position: absolute; inset: 0;
border: 1px solid rgba(181,154,106,0.35);
border-radius: 3px;
pointer-events: none;
}
.story-quote {
font-family: var(--ff-script);
font-size: clamp(1.4rem, 4vw, 2rem);
color: var(--sage);
margin: 2rem 0;
line-height: 1.4;
}

/* ─── DETAILS GRID ────────────────────────────────────────── */
#details {
background: var(--beige);
text-align: center;
}
.details-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
gap: 1.5rem;
max-width: 960px;
margin: 0 auto;
}
.detail-card {
background: var(--white);
border-radius: 4px;
padding: 2.5rem 2rem;
box-shadow: 0 2px 16px rgba(58,44,34,0.07);
transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
}
.detail-card:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(58,44,34,0.12); }
.detail-icon {
width: 52px; height: 52px;
border-radius: 50%;
background: var(--linen);
margin: 0 auto 1.25rem;
display: flex; align-items: center; justify-content: center;
font-size: 1.4rem;
}
.detail-card-title {
font-family: var(--ff-script);
font-size: 1.7rem;
color: var(--brown);
margin-bottom: 0.5rem;
}
.detail-card-text {
font-family: var(--ff-serif);
font-size: 0.95rem;
color: var(--brown-md);
line-height: 1.7;
font-style: italic;
}
.detail-card-sub {
font-family: var(--ff-sans);
font-size: 0.65rem;
letter-spacing: 0.18em;
text-transform: uppercase;
color: var(--sage);
margin-top: 0.5rem;
}

/* ─── GALLERY ─────────────────────────────────────────────── */
#gallery { text-align: center; }
.gallery-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 1rem;
max-width: 900px;
margin: 0 auto;
}
@media (max-width: 640px) {
.gallery-grid { grid-template-columns: repeat(2, 1fr); }
}
.gallery-item {
border-radius: 3px;
overflow: hidden;
aspect-ratio: 4/5;
position: relative;
background: var(--beige);
}
.gallery-item:nth-child(2) { aspect-ratio: 4/5; grid-row: span 1; }
.gallery-item:first-child { grid-row: span 2; aspect-ratio: auto; }
.gallery-item img {
width: 100%; height: 100%;
object-fit: cover;
transition: transform 0.7s var(--ease-out);
}
.gallery-item:hover img { transform: scale(1.04); }
.gallery-item:nth-child(1) { background: #c5d4c1; }
.gallery-item:nth-child(2) { background: #d9cfc4; }
.gallery-item:nth-child(3) { background: #bfcfbb; }
.gallery-item:nth-child(4) { background: #e5ddd3; }
.gallery-item:nth-child(5) { background: #cad8c6; }
.gallery-placeholder {
position: absolute; inset: 0;
display: flex; align-items: center; justify-content: center;
font-family: var(--ff-script);
font-size: 2rem;
color: rgba(58,44,34,0.18);
}

/* ─── FOOTER ──────────────────────────────────────────────── */
footer {
background: var(--brown);
padding: 4rem 2rem;
text-align: center;
position: relative;
overflow: hidden;
}
footer::before {
content: '';
position: absolute; inset: 0;
background: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(138,158,133,0.08), transparent);
pointer-events: none;
}
.footer-names {
font-family: var(--ff-script);
font-size: clamp(2.4rem, 6vw, 3.6rem);
color: var(--cream);
margin-bottom: 0.5rem;
}
.footer-date {
font-family: var(--ff-sans);
font-size: 0.65rem;
letter-spacing: 0.28em;
text-transform: uppercase;
color: var(--sage-lt);
opacity: 0.7;
margin-bottom: 2rem;
}
.footer-divider {
width: 40px; height: 1px;
background: var(--gold);
margin: 0 auto 1.5rem;
opacity: 0.5;
}
.footer-note {
font-family: var(--ff-serif);
font-size: 0.85rem;
color: var(--beige);
opacity: 0.5;
font-style: italic;
}

/* ─── FAQ ─────────────────────────────────────────────────── */
#faq { background: var(--cream); text-align: center; }
.faq-list {
max-width: 700px;
margin: 0 auto;
text-align: left;
}
.faq-item {
border-bottom: 1px solid rgba(138,158,133,0.25);
}
.faq-item:first-child {
border-top: 1px solid rgba(138,158,133,0.25);
}
.faq-question {
width: 100%;
background: none;
border: none;
cursor: pointer;
display: flex;
align-items: center;
justify-content: space-between;
gap: 1rem;
padding: 1.4rem 0;
font-family: var(--ff-serif);
font-size: 1.05rem;
color: var(--brown);
text-align: left;
line-height: 1.4;
transition: color 0.2s;
}
.faq-question:hover { color: var(--sage); }
.faq-icon {
flex-shrink: 0;
width: 22px; height: 22px;
border-radius: 50%;
border: 1px solid var(--sage-lt);
display: flex; align-items: center; justify-content: center;
color: var(--gold);
font-size: 0.85rem;
transition: transform 0.35s var(--ease-out), background 0.2s, border-color 0.2s;
}
.faq-item.open .faq-icon {
transform: rotate(45deg);
background: var(--brown);
border-color: var(--brown);
color: var(--cream);
}
.faq-answer {
overflow: hidden;
max-height: 0;
transition: max-height 0.4s var(--ease-out), padding 0.3s;
}
.faq-item.open .faq-answer {
max-height: 400px;
}
.faq-answer-inner {
font-family: var(--ff-serif);
font-size: 0.97rem;
color: var(--brown-md);
line-height: 1.85;
font-style: italic;
padding-bottom: 1.4rem;
}

/* ─── INLINE SVG FLORALS (CSS) ────────────────────────────── */
.floral-svg { fill: none; stroke: var(--sage); stroke-width: 0.8; }

/* ─── RESPONSIVE ──────────────────────────────────────────── */
@media (max-width: 768px) {
nav { gap: 1.2rem; padding: 1rem 1.5rem; }
.rsvp-card { padding: 2.5rem 1.5rem; }
.countdown-sep { display: none; }
}
@media (max-width: 480px) {
nav { flex-wrap: wrap; gap: 0.8rem 1.5rem; }
.gallery-grid { grid-template-columns: 1fr 1fr; }
.gallery-item:first-child { grid-row: span 1; aspect-ratio: 4/5; }
}
</style>

</head>
